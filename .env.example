# Copiar a .env.local (nunca commitear ese archivo).
# En Vercel, cargar estas mismas variables en Project Settings > Environment Variables.

# Lista de usuarios habilitados para loguearse, en formato JSON.
# Un objeto por persona/área: { "user": "...", "pass": "...", "area": "..." }
AUTH_USERS=[{"user":"@ejemplo","pass":"cambiar_esta_contraseña","area":"Ejemplo"}]

# Clave para firmar la cookie de sesión (HMAC). Generarla una sola vez con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=cambiar_por_una_clave_aleatoria_larga
