# Copiar a .env.local (nunca commitear ese archivo).
# En Vercel, cargar estas mismas variables en Project Settings > Environment Variables.

# Lista de usuarios habilitados para loguearse, en formato JSON.
# Un objeto por persona/área: { "user": "...", "pass": "...", "area": "..." }
# "role" es opcional: solo agregarlo con el valor "admin" a quienes deban
# tener acceso total a secciones restringidas (ver config/permisos.js). Si
# no está presente, el usuario se trata como normal (comportamiento actual).
AUTH_USERS=[{"user":"@ejemplo","pass":"cambiar_esta_contraseña","area":"Ejemplo"},{"user":"@admin_ejemplo","pass":"cambiar_esta_contraseña","area":"Ejemplo","role":"admin"}]

# Clave para firmar la cookie de sesión (HMAC). Generarla una sola vez con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=cambiar_por_una_clave_aleatoria_larga

# --- Reporte semanal de vencimientos (pages/api/cron/vencimientos-semanal.js) ---
# Secreto que valida el cron de Vercel (header "Authorization: Bearer <CRON_SECRET>").
# Generarlo igual que SESSION_SECRET, con el mismo comando de node de arriba.
CRON_SECRET=cambiar_por_otra_clave_aleatoria_larga

# Cuenta de Google Workspace que envía el mail (la misma cuenta existente de
# Tomás). EMAIL_APP_PASSWORD es una "contraseña de aplicación" de Google
# (myaccount.google.com/apppasswords), NO la contraseña real de la cuenta.
EMAIL_USER=cuenta@dominio.com
EMAIL_APP_PASSWORD=contraseña_de_aplicación_de_16_caracteres

# Uno o más destinatarios del reporte semanal, separados por coma.
EMAIL_TO=tomigaston15@gmail.com
