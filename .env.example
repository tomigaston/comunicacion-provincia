# Copiar a .env.local (nunca commitear ese archivo).
# En Vercel, cargar estas mismas variables en Project Settings > Environment Variables.

# Lista de usuarios habilitados para loguearse, en formato JSON.
# Un objeto por persona/área: { "user": "...", "pass": "...", "area": "..." }
# "role" es opcional: solo agregarlo con el valor "admin" a quienes deban
# tener acceso total a secciones restringidas (ver config/permisos.js). Si
# no está presente, el usuario se trata como normal (comportamiento actual).
AUTH_USERS=[{"user":"@ejemplo","pass":"cambiar_esta_contraseña","area":"Ejemplo"},{"user":"@admin_ejemplo","pass":"cambiar_esta_contraseña","area":"Ejemplo","role":"admin"}]

# Clave para firmar la cookie de sesión (HMAC). Generarla una sola vez con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=cambiar_por_una_clave_aleatoria_larga
